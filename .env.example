# Copy to .env (never commit .env). In Azure these values come from Key Vault (SR4).
MSSQL_SA_PASSWORD=ChangeMe_Local1!
# Host port. 14330 avoids the default 1433; keep SQL_CONNECTION_STRING in step with it.
MSSQL_PORT=14330
SQL_CONNECTION_STRING=Server=localhost,14330;Database=Iso20022;User Id=sa;Password=ChangeMe_Local1!;TrustServerCertificate=True
BLOB_CONNECTION_STRING=
BLOB_CONTAINER=iso20022
API_KEY=
KEY_VAULT_URI=
